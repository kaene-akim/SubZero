# ─── Core ────────────────────────────────────────────────────────────────────
# Public origin used to build OAuth redirects and links in emails.
APP_URL=http://localhost:3000
NODE_ENV=development

# 32+ char random string. Generate: openssl rand -base64 48
AUTH_SECRET=
# 32-byte base64 key used to encrypt OAuth refresh tokens at rest.
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=

# ─── Database ────────────────────────────────────────────────────────────────
# Leave empty to use embedded PostgreSQL (PGlite) stored in .data/pg.
# Set to a PostgreSQL connection string for production / Supabase.
DATABASE_URL=

# ─── Google OAuth / Gmail ────────────────────────────────────────────────────
# Create an OAuth 2.0 Web client in Google Cloud Console and enable the Gmail API.
# Authorised redirect URI: {APP_URL}/api/integrations/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# When true, the Gmail integration uses an explicitly-labelled sandbox inbox
# instead of calling Google. Never enable in production. The UI shows a banner.
GMAIL_MOCK=false

# ─── Optional AI classification ──────────────────────────────────────────────
# OpenAI-compatible endpoint. Deterministic rules always run first; the LLM only
# adds evidence for ambiguous messages and is validated against a strict schema.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ─── Optional Open Banking (UK) ──────────────────────────────────────────────
OPEN_BANKING_PROVIDER=truelayer
TRUELAYER_CLIENT_ID=
TRUELAYER_CLIENT_SECRET=
TRUELAYER_REDIRECT_URI=
BANK_MOCK=false

# ─── Payments (platform billing / future unified checkout) ───────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Notifications ───────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=SubZero <notifications@subzero.local>
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:security@subzero.local

# ─── Background jobs ─────────────────────────────────────────────────────────
# Shared secret for POST /api/cron/tick (Inngest/Trigger.dev or system cron).
CRON_SECRET=
# In development the dashboard can run the scheduler inline.
JOBS_INLINE=true

# ─── Exchange rates ──────────────────────────────────────────────────────────
# Optional. When unset, the seeded reference table is used and the UI labels
# conversions as indicative. Do not present converted values as settlement rates.
EXCHANGE_RATE_API_KEY=
